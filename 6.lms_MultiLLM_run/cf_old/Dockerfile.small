# lms:small — 저사양 GPU 멀티 LLM 테스트용 경량 이미지
#   FROM lms:latest 레이어 추가 방식 — lms:latest 원본은 절대 변경되지 않음.
#   모델: google/gemma-4-e2b (4.6B, Q4_K_M 3.2GB)
#     · context_length 131072 (128k) — gemma4 아키텍처 최대치 그대로 사용 가능
#     · KV 헤드 1개(MQA) + sliding window 512 → 128k 풀 컨텍스트도 KV 캐시 ~1.5GB
#     · 백엔드 1개당 VRAM ≈ 5GB → 16GB GPU 에 2개 동시 탑재 가능
#   빌드:
#     ./build.small.sh          # 권장 (모델 파일 준비 + docker build)
#     또는: docker build -f Dockerfile.small -t lms:small build.small/
#   참고: named volume 을 새로 만들어 /home/lms/.lmstudio/models 에 마운트하면
#         docker 가 이미지 내용을 볼륨에 자동 복사(프리팝)하므로 air-gap 반입 후
#         별도 모델 복사 절차가 필요 없음.
FROM lms:latest

# 소형 모델을 이미지에 내장 (신규 볼륨 프리팝용)
COPY --chown=lms:lms models/ /home/lms/.lmstudio/models/

# entrypoint 내장 — lms:latest 의 ENTRYPOINT 는 'sleep infinity' (air-gap 반입본 특성).
#   5판(compose)은 이미지 내장 entrypoint 를 전제하므로 필수.
#   6판 start.sh 는 어차피 :ro 마운트 + --entrypoint 로 오버라이드 → 영향 없음.
COPY --chmod=755 entrypoint.lms.sh /usr/local/bin/entrypoint.lms.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.lms.sh"]

# 직접 docker run 시의 기본값 — start.sh(.env) 사용 시엔 -e 주입값이 우선
ENV LMS_MODEL=google/gemma-4-e2b \
    LMS_CONTEXT_LENGTH=131072 \
    LMS_PARALLEL=1
